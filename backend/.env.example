# Copiez ce fichier vers backend/.env puis renseignez les valeurs.
# Ne versionnez jamais backend/.env.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# Obligatoire : genere avec `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Limitation de debit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Messagerie : limitation anti-abus (optionnel)
MESSAGE_RATE_LIMIT_MAX=40
CONVERSATION_RATE_LIMIT_MAX=40

# Base de donnees MySQL / MariaDB
# En production, creez un utilisateur dedie avec des droits limites (pas root).
DB_HOST=localhost
DB_PORT=3306
DB_USER=naatal_app
DB_PASSWORD=
DB_NAME=naatal_dakar
DB_POOL_SIZE=10

# Insere les donnees de demonstration si les tables sont vides
DB_AUTO_SEED=true

# Compte administrateur initial : aucun mot de passe par defaut.
# 8 caracteres minimum, avec majuscule, minuscule, chiffre et caractere special.
ADMIN_NAME=Administrateur NAATAL
ADMIN_EMAIL=admin@naatal.dakar
ADMIN_PASSWORD=
